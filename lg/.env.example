# lg-mangaka local dev env. Copy to `.env` and fill in.
#
# Pure-dev mode (no external services): leave everything commented out and
# invoke graphs from Studio with `dry_run: true` in the input. The cine_*
# graphs short-circuit all persists / blob PUTs in that mode.
#
# Connected-dev mode: uncomment what you have. Each helper degrades to a
# logged stub when its env var is absent.

# ── identity ──────────────────────────────────────────────────────────────
# MANGAKA_APP_DID=did:web:mangaka.etzhayyim.com
# MANGAKA_ORG_DID=anon

# ── persistence (RisingWave PG :4566) ─────────────────────────────────────
# Required for non-dry_run runs. Without it cine_generate_scene returns
# {"error":"RW_URL not configured"} from the first stage's record_stage call.
# RW_URL=postgresql://root@127.0.0.1:4566/dev
# LG_CHECKPOINTER_URL=                # falls back to RW_URL

# ── LLM (vLLM on RunPod, OpenAI-compatible) ───────────────────────────────
# VLLM_URL=https://vyp99t9px7h4dl-4000.proxy.runpod.net/v1
# VLLM_MODEL=tier0-general
# VLLM_TIMEOUT_SEC=60

# ── Optional: OpenAI vision for the in-panel critique score ──────────────
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_VISION_MODEL=gpt-4o-mini

# ── ComfyUI (real image generation for diffusionPass stage) ─────────────
# Gateway path (PREFERRED — production CF Worker, Mac mini fleet behind).
# COMFYUI_URL defaults to https://comfyui.etzhayyim.com; only override for staging.
# COMFYUI_API_KEY must be a sk_live_* API key minted against vertex_api_key
# (the gateway returns 401 "invalid or missing api key" without it).
# COMFYUI_URL=https://comfyui.etzhayyim.com
# COMFYUI_API_KEY=sk_live_comfyui_XXXXXXXXXX
# COMFY_DEFAULT_CKPT=animagine-xl-4.0.safetensors   # anime SDXL, manga-friendly
#
# Raw-pod path (FALLBACK / legacy, no auth, direct ComfyUI on :8188):
# COMFY_POD_URL=https://<podid>-8188.proxy.runpod.net
# COMFYUI_POD_URL=https://<podid>-8188.proxy.runpod.net    # alias
#
# LAN Mac mini ComfyUI (when running scripts/dev.sh from the same subnet):
# COMFY_POD_URL=http://192.168.1.70:8188

# ── B2 (blob storage) ────────────────────────────────────────────────────
# When unset, blob.put_content_addressed() returns a `stub/...` key and
# the cine.* records are persisted with that stub. Fine for dev.
# B2_ENDPOINT=s3.us-west-004.backblazeb2.com
# B2_BUCKET=etzhayyim-pds-prod
# B2_REGION=us-west-004
# B2_KEY_ID=
# B2_SECRET_KEY=

# ── Audit (BPMN dispatcher) ───────────────────────────────────────────────
# Audit is fire-and-forget; missing dispatcher just logs. Set to 1 to skip
# the network attempt entirely.
LG_AUDIT_DISABLED=1
# BPMN_DISPATCHER_INTERNAL_URL=http://bpmn-dispatcher.mitama-udf.svc.cluster.local:8080
# BPMN_DISPATCHER_INTERNAL_SECRET=
