      "gh:keyMessages": [
        {
          "gh:speaker": "Nei",
          "gh:message": "設定は『鍵』のようなもの。家に鍵をかけるのは大切だけど、それだけで家族を守れるわけじゃない。"
        },
        {
          "gh:speaker": "Ren",
          "gh:message": "大事なのは、なぜその設定が必要か、一緒に考えること。監視じゃなくて、信頼の上に立った約束。"
        },
        {
          "gh:speaker": "Nei",
          "gh:message": "子供は成長する。設定も、関係も、アップデートが必要。定期的に話し合ってね。"
        }
      ],
      "gh:practicalAdvice": [
        {
          "gh:title": "デジタル家族会議",
          "gh:description": "月に1回、スマホの使い方について話し合う時間を設ける",
          "gh:topics": [
            "最近見た面白い動画/不快だった動画",
            "新しく使いたいアプリ",
            "困ったこと・相談したいこと",
            "設定の見直し"
          ]
        },
        {
          "gh:title": "家族のスマホルール",
          "gh:description": "紙に書いて見える場所に貼る",
          "gh:examples": [
            "食事中はスマホを触らない",
            "21時以降は充電場所に置く",
            "知らない人からのメッセージは必ず相談する",
            "課金する前は必ず相談する",
            "困ったことがあったら怒らないから話して"
          ]
        },
        {
          "gh:title": "親も学ぶ姿勢",
          "gh:description": "子供が使っているアプリを親も体験してみる",
          "gh:benefit": "共通の話題ができ、リスクも理解しやすくなる"
        }
      ],
      "gh:finalMessage": {
        "gh:speaker": "美咲",
        "gh:message": "設定のことばかり考えてたけど…一番大切なのは、Yutoと話すことなんですね。",
        "gh:response": {
          "gh:speaker": "Yuto",
          "gh:message": "…僕も、もっと早く相談すればよかった。これからは、ちゃんと話すよ。"
        }
      }
