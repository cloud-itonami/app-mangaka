  "gh:episodeId": "episode:arc0-1-origin",
  "gh:slug": "arc-0-1-password-do-not-remember",
  "gh:subtitle": "Don't Memorize Passwords",
  "gh:tagline": "パスワードは、覚えるな。作って、預けろ。",
  "gh:volume": "45 pages + pretitle (NeiPuni columns placed in margins / between acts)",
  "gh:setting": {
    "gh:era": "中学生時代（Ren 15歳・中3末）",
