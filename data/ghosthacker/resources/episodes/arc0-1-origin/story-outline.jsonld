    ]
  },
  "gh:theses": {
    "gh:practical": "パスワードは、覚えるな。作って、預けろ",
    "gh:psychological": "悪いのは、あなたじゃない。アクターだ",
    "gh:philosophical": "情報は、物理だ"
  },
  "gh:protagonistArc": {
    "gh:from": "7年間1人で父の系譜を追ってきたRen（停滞）",
    "gh:to": "他人の事件を解決することで犯人に近づくと気づき、高校から「事務所」を始める決意",
    "gh:decisivePage": 44,
    "gh:decisiveChoice": "1件ずつ人を助けることを、仕事にすると決める瞬間"
  },
  "gh:complianceNote": {
    "gh:rule": "Renはネットワーク監視をしない。Neiが学校でYutoの異変を察知 → Renに繋ぐ",
    "gh:renActivity": "自分でアクセス権のある範囲（父の遺したサーバ・父名義のメール過去ログ・公開情報OSINT）のみ",
    "gh:logSharing": "Yuto事件のログは、Yuto本人の同意の元、Yutoのスマホから共有される形"
  },
