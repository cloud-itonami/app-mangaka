  "gh:castOfCharacters": [
    {
      "@id": "character:Ren",
      "gh:displayName": "沼野 蓮 / Ren",
      "gh:age": 15,
      "gh:grade": "中3",
      "gh:role": "Ghost Hacker 予備軍 / 主人公",
      "gh:description": "7年前（小3冬・8歳）、父・信哉が国民年金情報の次世代防御基盤プロジェクトを率いていた最中、標的型メール+ランサムウェアの複合攻撃でプロジェクトが壊滅。約400万件の年金記録が流出+一部完全喪失。父はプロジェクト責任者として公的責任を取らされ、半年後に自死。独学でハッキング技術を蓄積。父の遺した系譜を追っているが1人では末端に届かず停滞している。授業中は寝ている（中学時代限定）",
      "gh:creed": "一件ずつ潰すのは、怠惰のやることじゃない。根っこを切る。一回で",
      "gh:visualTell": "瞳が銀色に光る瞬間（情報場が見えた時）"
    },
    {
      "@id": "character:Nei",
      "gh:displayName": "白瀬 寧 / Nei",
      "gh:age": 15,
      "gh:grade": "中3（D組）",
      "gh:role": "ヒロイン / 観察者 / Renの幼馴染（隣家・5歳から）",
      "gh:description": "他人には丁寧語基調、Renにだけ常にタメ口・呼び捨て。食いしん坊。ASD特性（数値化癖・聴覚過敏・比喩の直訳・心理学）。父は白瀬聡（情報物理応用研究所・Holonium Vision世界初実装）。本話の事件の発見者",
      "gh:favoriteThings": ["コメッコンシリーズ", "物理工学"]
    },
    {
      "@id": "character:Yuto",
      "gh:displayName": "藤崎 悠斗 / Yuto",
      "gh:age": 15,
      "gh:grade": "中3 B組",
      "gh:role": "本話の依頼人 / 被害者",
      "gh:description": "真面目で温厚、少し気弱。Renとは席が近いが話したことはほとんどない。Neiとは学年が同じだけで面識はほぼない"
    },
    {
      "@id": "character:Kazuo",
      "gh:displayName": "藤崎 和夫 / Kazuo",
      "gh:age": 45,
      "gh:role": "Yutoの父",
      "gh:description": "中小食品メーカーの営業部課長。週の半分は出張・接待で帰宅が遅い。ITは会社のメールを読める程度。穏やかだが、お金関係の大きな判断は父が引き受ける"
    },
    {
      "@id": "character:Yuko",
      "gh:displayName": "藤崎 裕子 / Yuko",
      "gh:age": 42,
      "gh:role": "Yutoの母",
      "gh:description": "近所のドラッグストアでパート勤務。家計はスマホのレシート写メアプリで管理。家事・子育てを主に担当。口数は少なめだが、目を見て聞くタイプ。Yutoの生活リズムをずっと見ている"
    },
    {
      "@id": "character:Akira",
      "gh:displayName": "林 彰 / Akira",
      "gh:age": 15,
      "gh:role": "Yutoの友人 / スニーカー自慢",
      "gh:description": "本命はHolonium Vision。論文には10年前から書かれていたが実物が見られるのは自分たちが最初の世代だと熱弁する"
    },
    {
      "@id": "character:Saki",
