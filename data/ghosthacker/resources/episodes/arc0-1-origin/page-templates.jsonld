{
  "@context": {
    "gh": "https://ghosthacker.etzhayyim.com/ns/",
    "tpl": "gh:template/"
  },
  "@id": "gh:page-templates/jump-v1",
  "gh:format": "weekly-shounen-jump-A4",
  "gh:units": "mm",
  "gh:canvas": {
    "gh:trim":   {"width": 210, "height": 297},
    "gh:bleed":  3,
    "gh:innerFrame": {"x": 15, "y": 15, "width": 180, "height": 270},
    "gh:gutter": {"horizontalMm": 3, "verticalMm": 3},
    "gh:pageNumberArea": {"corner": "outer-bottom", "xMm": 175, "yMm": 277}
  },
  "gh:readingDirection": "right-to-left, top-to-bottom",
  "gh:templates": [
    {"@id": "tpl:impact-spread-1", "gh:name": "Impact Spread (1 panel = 1 page)", "gh:panelCount": 1, "gh:emotionalProfile": ["impact","punchline"], "gh:panels": [
      {"slot":1,"shape":"rect","bounds":{"xMm":0,"yMm":0,"wMm":180,"hMm":270},"emphasis":"impact","readingOrder":1}
    ]},
    {"@id": "tpl:standard-grid-4", "gh:name": "Standard 4-panel grid (2x2)", "gh:panelCount": 4, "gh:emotionalProfile": ["establish","beat","beat","punchline"], "gh:panels": [
      {"slot":1,"shape":"rect","bounds":{"xMm":0,"yMm":0,"wMm":88,"hMm":132},"emphasis":"establish","readingOrder":1},
      {"slot":2,"shape":"rect","bounds":{"xMm":92,"yMm":0,"wMm":88,"hMm":132},"emphasis":"beat","readingOrder":2},
      {"slot":3,"shape":"rect","bounds":{"xMm":0,"yMm":138,"wMm":88,"hMm":132},"emphasis":"beat","readingOrder":3},
      {"slot":4,"shape":"rect","bounds":{"xMm":92,"yMm":138,"wMm":88,"hMm":132},"emphasis":"punchline","readingOrder":4}
    ]},
    {"@id": "tpl:jump-build-release-5", "gh:name": "Jump 5-panel build-and-release", "gh:panelCount": 5, "gh:emotionalProfile":["establish","beat","beat","transition","punchline"], "gh:panels": [
      {"slot":1,"shape":"rect","bounds":{"xMm":0,"yMm":0,"wMm":88,"hMm":70},"emphasis":"establish","readingOrder":1},
      {"slot":2,"shape":"rect","bounds":{"xMm":92,"yMm":0,"wMm":88,"hMm":70},"emphasis":"beat","readingOrder":2},
      {"slot":3,"shape":"rect","bounds":{"xMm":0,"yMm":76,"wMm":60,"hMm":80},"emphasis":"beat","readingOrder":3},
      {"slot":4,"shape":"rect","bounds":{"xMm":64,"yMm":76,"wMm":116,"hMm":80},"emphasis":"transition","readingOrder":4},
      {"slot":5,"shape":"rect","bounds":{"xMm":0,"yMm":162,"wMm":180,"hMm":108},"emphasis":"punchline","readingOrder":5}
    ]},
    {"@id": "tpl:jump-build-release-6", "gh:name": "Jump 6-panel build-and-release", "gh:panelCount": 6, "gh:emotionalProfile":["establish","beat","beat","beat","build","punchline"], "gh:panels": [
      {"slot":1,"shape":"rect","bounds":{"xMm":0,"yMm":0,"wMm":116,"hMm":70},"emphasis":"establish","readingOrder":1},
