              "gh:maxWidthFraction": 0.5,
              "gh:maxHeightFraction": 0.4,
              "gh:bubbleIndex": 7,
              "gh:speaker": "Ren",
              "gh:text": "根っこを切るには、1件ずつ、ゴーストハックするのが、一番早いって、今日、Yutoで、気づいた"
            },
            {
              "gh:sizeMode": "auto",
