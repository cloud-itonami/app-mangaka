              "gh:maxWidthFraction": 0.5,
              "gh:maxHeightFraction": 0.4,
              "gh:bubbleIndex": 4,
              "gh:speaker": "Ren",
              "gh:text": "——ゴーストハッカーの、戦闘原理だ"
            },
            {
              "gh:sizeMode": "auto",
              "gh:widthMm": null,
              "gh:heightMm": null,
              "gh:position": {
                "xMm": null,
                "yMm": null,
                "relativeToPanel": true
              },
              "gh:tail": {
