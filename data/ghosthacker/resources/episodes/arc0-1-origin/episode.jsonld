              "gh:maxWidthFraction": 0.5,
              "gh:maxHeightFraction": 0.4,
              "gh:bubbleIndex": 5,
              "gh:speaker": "Ren",
              "gh:text": "1件ずつ、ベクトルを、揃えてくと、父さんの、犯人まで、繋がるし、父さんが残したパスワードロックも、開く"
            },
            {
              "gh:sizeMode": "auto",
              "gh:widthMm": null,
              "gh:heightMm": null,
              "gh:position": {
                "xMm": null,
                "yMm": null,
