              "gh:maxWidthFraction": 0.5,
              "gh:maxHeightFraction": 0.4,
              "gh:bubbleIndex": 6,
              "gh:speaker": "Nei",
              "gh:text": "レンが、1件ずつって、言うの、初めて"
            },
