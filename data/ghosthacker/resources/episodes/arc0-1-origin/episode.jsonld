        {
          "@id": "panel:p44n7-v3",
          "characters": [
            "character:Ren",
            "character:Nei"
          ],
          "dialogue": [
            {
              "speaker": "Ren",
              "text": "努力、友情、勝利"
            },
            {
              "speaker": "Nei",
              "text": "ジャンプ三原則"
            },
            {
              "speaker": "Ren",
              "text": "父さんが、方程式化してた、やつだ"
            },
            {
              "speaker": "Ren",
              "text": "個々の努力で、仲間と整列して、計算的に勝つ"
            },
            {
              "speaker": "Ren",
              "text": "——ゴーストハッカーの、戦闘原理だ"
            },
            {
              "speaker": "Ren",
              "text": "1件ずつ、ベクトルを、揃えてくと、父さんの、犯人まで、繋がるし、父さんが残したパスワードロックも、開く"
            },
            {
              "speaker": "Nei",
              "text": "レンが、1件ずつって、言うの、初めて"
            },
            {
              "speaker": "Ren",
              "text": "根っこを切るには、1件ずつ、ゴーストハックするのが、一番早いって、今日、Yutoで、気づいた"
            },
            {
              "speaker": "Ren",
              "text": "だから——人を助ける。ゴーストハッカー。サイバーセキュリティじゃなくて"
            }
          ],
