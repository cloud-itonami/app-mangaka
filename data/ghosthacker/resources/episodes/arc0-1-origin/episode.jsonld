              "gh:bubbleIndex": 3,
              "gh:speaker": "Ren",
              "gh:text": "個々の努力で、仲間と整列して、計算的に勝つ"
            },
            {
              "gh:sizeMode": "auto",
              "gh:widthMm": null,
              "gh:heightMm": null,
              "gh:position": {
                "xMm": null,
