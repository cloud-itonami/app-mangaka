      "gh:actNumber": 5,
      "gh:actTitle": "救いの手",
      "gh:actTitleEn": "Helping Hand",
      "gh:emotionalArc": "孤立 → 接触 → 希望",
      "gh:keyBeat": "turn",
      "gh:narrativePurpose": "Yuto が最初に Saki に声をかける（arc0-1 の経験の継承）。Yuto が Nei に繋ぎ、Nei が Ren に繋ぐ",
      "gh:pageRange": [28, 31]
    },
    {
      "@id": "act:6-countermeasures",
      "gh:actNumber": 6,
      "gh:actTitle": "対策",
      "gh:actTitleEn": "Countermeasures",
      "gh:countermeasures": [
        {"gh:step": 1, "gh:title": "アカウント設定の確認", "gh:titleEn": "Account Settings Audit", "gh:pages": [32, 33], "gh:description": "公開範囲・タグ付け許可・DM受信範囲・位置情報。鍵垢の各サービスの『鍵』の実体を確認"},
        {"gh:step": 2, "gh:title": "二要素認証の設定", "gh:titleEn": "Two-Factor Hardening", "gh:pages": [34, 35], "gh:description": "SMS OTP < 認証アプリ < ハードウェアキー の強度比較。AuthHiveアプリで全サービス2FA移行"},
        {"gh:step": 3, "gh:title": "連携アプリの整理", "gh:titleEn": "Connected Apps Cleanup", "gh:pages": [36, 37], "gh:description": "47個の連携アプリの棚卸し。権限レベル別仕分け。読み取り専用 vs 投稿権限"},
        {"gh:step": 4, "gh:title": "デジタル足跡の理解", "gh:titleEn": "Digital Footprint", "gh:pages": [38, 39], "gh:description": "鍵垢の投稿はサーバ側に永遠に残る。書く前に止まる習慣"}
      ],
      "gh:emotionalArc": "混乱 → 理解 → 達成感",
      "gh:keyBeat": "education",
      "gh:narrativePurpose": "具体的なセキュリティ対策を読者に伝える",
      "gh:pageRange": [32, 39]
    },
    {
