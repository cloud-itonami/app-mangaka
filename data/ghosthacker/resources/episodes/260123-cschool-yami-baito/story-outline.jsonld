  "gh:neiPuniColumns": {
    "gh:placementRule": "本編コマ外・柱・章間見開きに配置。本編には基本的に入れない",
    "gh:perPageColumns": [
      {"gh:page": 0, "gh:text": "『簡単に稼げる』には必ず裏があります。時給の異常な高さは、犯罪の値段です"},
      {"gh:page": 7, "gh:text": "口座・携帯・身分証を売ると、犯罪に使われて自分が加害者扱いされるリスクがあります"},
      {"gh:page": 13, "gh:text": "脅されたら、それは既に犯罪。あなたは加害者ではなく被害者です。早く相談すれば加害者にならずに済みます"},
      {"gh:page": 25, "gh:text": "未成年の闇バイト被害者は、早期相談で『被害者保護』の対象になることが多いです"},
      {"gh:page": 41, "gh:text": "助けを求めることは、強さです。『一人で抱え込まなくていい』"}
    ],
