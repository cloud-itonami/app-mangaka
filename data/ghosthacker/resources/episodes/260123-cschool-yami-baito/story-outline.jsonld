  "gh:designNotes": {
    "gh:complianceFix": [
      "Kanameの調査は OSINT・公開情報・本人合意ログの範囲のみ",
      "卒業生ネットワークを介した情報収集は『情報源を必ず明示』",
      "金融機関側の機密情報は叔父・水城慎司を介した規制側の正規ルートでしか触らない"
    ],
    "gh:religionContext": "キリスト教 / 聖公会 — 『正義は手続きの中に宿る』。Kanameは祈らないが、ロザリオは決断のスイッチ。Renの仏教(天台宗)、Chiseの神道(八幡信仰)と対比",
    "gh:hackerNuesConnection": "Act 6 で Kanameは Hacker Nues に匿名（3pa11er3apiv0t）で投稿#22 を書き込む。これは arc0-1 ページ7 でRenが読んでいた投稿。本話のラストでは、KanameがRen（Ghost_Owl）の投稿#44 と Chise（aka_chise1）の投稿#14 を見て『同業者がいる』と気づく。3者はまだ会わない",
    "gh:vapBeat": "本話のラスト（Act 7）で、Renの部屋のSIPデバイスが2回目の脈動を見せるコマを挿入。読者だけが見る。Vector Alignment Proofの数値はまだ1のまま — つまり、現時点で揃ったのは『悪いのはアクター』のベクトルが arc0-1 で1回成立しただけ。Chise・Kanameの揃い切りは Arc 1（連載第1話）以降",
    "gh:jumpThreePrinciples": {
      "gh:effort": "Soraが助けを求める勇気 / Kanameの夜中のリーガルパッド / 慎司の規制側ルートの再起動",
      "gh:friendship": "Kanameと健司の信頼 / 理香の観察眼 / KanameとSoraの距離が近づく",
      "gh:victory": "野村の特定と立件 / Soraの母との再会 / Kanameが『感情で動く』ことを認める"
    },
    "gh:trinityForeshadowing": "Arc 0-1（Ren / 中学生 / 仏教 / Cschool）→ Arc 0-2（Chise / 高校生 / 神道 / 都立工科） → Arc 0-3（Kaname / 高校生 / キリスト教 / 星蘭学院）の3者は、年齢・学校・宗教・拠点が違うが、Hacker Nuesの同一スレッドで観測しあっている。連載第1話で初めて1つの場で出会う"
  },
  "gh:educationalContent": {
    "gh:keyTakeaways": [
      "『簡単に稼げる』仕事には裏がある",
      "一度でも応じると、脅迫材料にされる",
      "脅されても、相談すれば助けてもらえる",
      "被害者は罪に問われないことが多い（早期相談が重要）",
      "口座や携帯を売ると、犯罪に使われて自分が加害者扱いされるリスク"
    ],
    "gh:mainMessage": "闇バイトは一度始めると抜け出しにくい。でも、被害者として助けを求めれば必ず道はある",
    "gh:resources": [
      "警察相談ダイヤル #9110",
