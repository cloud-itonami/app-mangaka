  "gh:neiPuniColumns": {
    "gh:placementRule": "本編コマ外・柱・章間見開きに配置。本編には基本的に入れない",
    "gh:perPageColumns": [
      {"gh:page": 0, "gh:text": "ドクシングは、被害が始まる前から進んでいます。あなたの日常の写真の背景に、住所が書いてあるかもしれない"},
      {"gh:page": 7, "gh:text": "嫌がらせの大量配達は、威力業務妨害罪。配達業者にも『心当たりがない』と言えば対応してもらえます"},
      {"gh:page": 19, "gh:text": "『消すな、残せ』。スクショ・URL・日時・ハッシュ。これがあれば、後で動けます"},
      {"gh:page": 26, "gh:text": "発信者情報開示請求は、2022年の法改正で『開示命令』が新設され、以前より早く・安くなりました"},
      {"gh:page": 41, "gh:text": "声を上げることは恥ずかしくない。あなたが残した記録が、次の被害者を救います"}
    ],
    "gh:interludeColumns": [
      {
        "gh:placement": "Act 4 → Act 5 の境界",
        "gh:title": "証拠の残し方・残さない方",
        "gh:items": [
          "スクショは『画面全体』+ 時計・URLが見える形で",
          "魚拓サービスは複数（archive.today / Wayback Machine）",
          "ハッシュ値（SHA-256）を取って改ざんされていないことを示す",
          "クラウドに自動バックアップを忘れない",
          "削除しても消えない。プラットフォームのログは残る"
        ]
      },
      {
        "gh:placement": "Act 6 → Act 7 の境界",
        "gh:title": "発信者情報開示請求 — 流れと費用",
        "gh:items": [
          "STEP 1: コンテンツプロバイダ（SNS）にIPアドレス開示の仮処分",
          "STEP 2: アクセスプロバイダに発信者情報の開示請求",
          "STEP 3: 民事訴訟または刑事告訴",
          "費用目安: 弁護士着手金10〜20万円、成功報酬20〜30万円",
          "2022年法改正後は『開示命令』で1ステップに簡素化されつつある"
        ]
      }
    ]
  },
  "gh:designNotes": {
    "gh:complianceFix": [
      "Chiseは合法的な範囲のみで動く（OSINT・被害者本人のログ・プラットフォーム通報・法的開示請求）",
      "Daichiから情報を取る時、Chiseは『これは合法か』を毎回問う（葛藤として描く）",
      "Hacker Nuesへの投稿は、特定可能な個人情報を含まない範囲のみ"
    ],
    "gh:religionContext": "神道 / 八幡信仰 — 『記録は祓いではない、奉納だ』。Chiseは祠で作業し、被害者に魚拓御札（朱印付き）を渡す。Renの仏教（天台宗）、Kanameのキリスト教（聖公会）と対比",
    "gh:hackerNuesConnection": "Act 5 で Chiseは Hacker Nues に匿名（aka_chise1）で投稿#14 を書き込む。これは arc0-1 ページ7 でRenが読んでいた投稿。本話のラストでは、ChiseがRen（Ghost_Owl）の投稿を見て『同業者がいる』と気づく",
    "gh:vapBeat": "本話のラスト（Act 7）で、Renの部屋のSIPデバイスが1px脈打つコマを挿入。読者だけが連載の縦糸を見える形にする。本人同士はまだ繋がらない",
    "gh:jumpThreePrinciples": {
      "gh:effort": "Chiseの神社籠もりからの再起 / Ryoが配信を再開する勇気 / Yuiの徹夜のログ解析",
      "gh:friendship": "ShotaがRyoを連れてくる / ChiseとYuiの長年の信頼 / Daichiとの危うい関係",
      "gh:victory": "発信者情報開示の成立 / Ryoの配信再開 / Chiseが『1人ではない』と気づく"
    }
  },
  "gh:educationalContent": {
    "gh:keyTakeaways": [
      "削除する前にスクショ・URLを保存する",
