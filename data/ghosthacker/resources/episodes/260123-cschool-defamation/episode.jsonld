  "dct:title": "Arc 0-2: 「恥じゃない。残すのが一番強い」",
  "gh:arc": "Arc 0",
  "gh:episode": 2,
  "gh:episodeId": "episode:260123-cschool-defamation",
  "gh:episodeIndex": 2,
  "gh:storyOutline": "story-outline.jsonld",
  "gh:tagline": "消すな。残せ。それが一番強い武器になる。",
  "gh:theme": "ネット上の誹謗中傷・ドクシングに対する正しい対処法",
  "gh:incidentDescription": "都立工科高校の人気ゲーム配信者・黒田涼（2年）がドクシング被害に遭う。住所を特定され、誹謗中傷が拡散、自宅や学校に嫌がらせが届く。元eスポーツ部エースで休学中の赤羽千世（HN: aka_chise1）が後輩の危機に立ち上がり、証拠保全から法的対処までを指揮する。",
  "gh:industry": "Student life (高校生)",
  "gh:mainCharacter": "character:Chise",
  "gh:mainLocation": "org:TokyoTechHighSchool",
  "gh:supportingCharacters": [
    "character:RyoKuroda",
    "character:ShotaHayashi",
    "character:YuiTanaka",
    "character:DaichiMori"
  ],
  "gh:nistFocus": [
    "PR.AA (Identity Management)",
    "DE.CM (Continuous Monitoring)",
    "RS.CO (Response Communications)"
  ],
  "gh:actStructure": [
    {
      "@id": "act:1-daily-life",
      "gh:actNumber": 1,
      "gh:actTitle": "日常と異変",
      "gh:actTitleEn": "Normal Life & Signs of Trouble",
      "gh:pageRange": [
        1,
        2
      ],
      "gh:narrativePurpose": "Ryoの配信者としての日常と、突然のドクシング攻撃開始を描く"
    },
    {
      "@id": "act:2-escalation",
      "gh:actNumber": 2,
      "gh:actTitle": "エスカレーション",
      "gh:actTitleEn": "Escalation",
      "gh:pageRange": [
        3,
        4
      ],
      "gh:narrativePurpose": "被害の深刻化と、Ryoの心理的追い詰められを描く"
    },
    {
      "@id": "act:3-encounter",
      "gh:actNumber": 3,
      "gh:actTitle": "出会い",
      "gh:actTitleEn": "Encounter",
      "gh:pageRange": [
        5,
        6
      ],
      "gh:narrativePurpose": "ShotaがRyoをChiseに紹介。Chiseの登場と第一声"
    },
    {
      "@id": "act:4-countermeasures",
      "gh:actNumber": 4,
      "gh:actTitle": "対策実行",
      "gh:actTitleEn": "Countermeasures",
      "gh:pageRange": [
        7,
        10
      ],
      "gh:narrativePurpose": "具体的な対処法を読者に伝える教育パート"
    },
    {
      "@id": "act:5-investigation",
      "gh:actNumber": 5,
      "gh:actTitle": "追跡",
      "gh:actTitleEn": "Investigation",
      "gh:pageRange": [
        11,
        14
      ],
      "gh:narrativePurpose": "Chiseのスキルを見せながら、犯人特定への道筋を描く"
    },
    {
      "@id": "act:6-confrontation",
      "gh:actNumber": 6,
      "gh:actTitle": "対決",
      "gh:actTitleEn": "Confrontation",
      "gh:pageRange": [
        15,
        16
      ],
      "gh:narrativePurpose": "犯人特定と法的解決への道"
    },
    {
      "@id": "act:7-resolution",
      "gh:actNumber": 7,
      "gh:actTitle": "再起",
      "gh:actTitleEn": "Resolution",
      "gh:pageRange": [
        17,
        18
      ],
      "gh:narrativePurpose": "被害からの回復と、Ryoの再出発"
    }
  ],
