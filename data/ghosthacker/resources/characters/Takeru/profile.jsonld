  "@id": "character:Chise",
  "schema:name": "赤羽 千世 (Chise Akabane)",
  "schema:role": "Street Hacker / Rival",
  "schema:age": 19,
  "gh:slug": "Chise",
  "gh:arc": "Arc 0-2 (Main) / Arc B (Rival)",

  "gh:appearance": {
    "gh:face": "19-year-old Japanese female, sharp and intense features, piercing amber eyes with a hint of defiance.",
    "gh:hair": "Long black hair with subtle red highlights, usually tied in a messy low ponytail or let loose.",
    "gh:build": "Slim but athletic, wearing high-end techwear/streetwear. Moves with an unconscious grace from shrine upbringing.",
    "gh:eyes": "Piercing amber irises, sharp and observant. Can shift from fierce to surprisingly gentle.",
    "gh:style": "Photorealistic, street aesthetic with subtle traditional undertones, high contrast, 8k.",
    "gh:generationPrompt": "photorealistic, 8k, highly detailed skin texture, cinematic lighting, raw photo, 19-year-old Japanese female, sharp intense features, piercing amber eyes, long black hair with red highlights in messy ponytail, techwear streetwear, confident defiant pose, subtle grace in posture."
  },

  "gh:background": {
    "gh:family": {
      "gh:structure": "両親健在。祖父母の家（神社）で育った。",
      "gh:grandfather": "赤羽八幡神社の現役宮司。穏やかで寡黙。千世を見守っている。",
      "gh:grandmother": "千世を名付けた人。元巫女。「千の世を生きてほしい」という願いを込めた。数年前に他界。",
      "gh:father": "宮司を継ぐ予定だったが会社員の道へ。神社の手伝いはする。",
      "gh:mother": "会社員。神社の行事を手伝う。"
    },
    "gh:shrineUpbringing": "赤羽八幡神社の境内で育った。参拝客、夜の常連、スケーター、地元のおっちゃん、様々な人と交流。ストリートカルチャーはここで自然に身についた。",
    "gh:hackerOrigin": "ある日、境内のベンチでノートPCを叩いていた男に「何してるの？」と声をかけた。『世界を覗いてる』と答えた男からプログラミングとハッキングの基礎を教わった。",
    "gh:school": "都立工科高等学校 3年（休学中）。元eスポーツ部エース。",
    "gh:currentState": "フリーランスのセキュリティコンサルタントとして活動。HN: aka_chise1（赤羽＋千世＋1）"
  },

  "gh:personality": {
    "gh:surface": "口が悪く、喧嘩っ早い。「めんどくせぇ」が口癖。ストリート系の振る舞い。",
    "gh:hidden": "弱い者いじめが大嫌い。神社仕込みの「守る」精神が根底にある。おばあちゃんの教え『困っている人を見捨てるな』を胸に刻んでいる。",
    "gh:motivation": "『やられたらやり返す』ではなく『やらせない』。証拠と手続きで潰すのが流儀。",
    "gh:weakness": "感情的になりやすい。おばあちゃんの話になると弱い。違法スレスレの手段に手を出しそうになることも。",
    "gh:gap": "正月は巫女装束で神社の手伝いをする。普段とのギャップに周囲は驚く。"
  },

  "gh:skills": {
    "gh:hackerName": "aka_chise1",
    "gh:nameOrigin": "aka（赤＝赤羽神社）+ chise（千世＝本名）+ 1（一番、唯一）",
    "gh:reputation": "アンダーグラウンドでは『赤羽の巫女』『報復の千世』として知られる",
    "gh:technical": [
      "OSINT（公開情報調査）",
      "ネットワーク解析",
      "デジタルフォレンジック",
      "ソーシャルエンジニアリング（対人ハック）"
    ],
    "gh:uniqueStrength": "神社育ちで培った人脈。地元の顔役から夜の住人まで、情報網が広い。"
  },

  "gh:relationships": {
    "gh:ren": {
      "gh:type": "ライバル / 同志",
      "gh:history": "オンラインで何度か対峙。互いの実力を認めている。",
      "gh:dynamic": "手法は違えど、目指す場所は同じ。Renの「だるい」にイラっとすることも。"
    },
    "gh:nei": {
      "gh:type": "知人",
      "gh:dynamic": "Neiの冷静さに時々イラっとするが、分析力は認めている。"
    },
    "gh:kaname": {
      "gh:type": "対極の存在",
      "gh:dynamic": "Kanameの『エリート』なやり方を鼻につくと思っている。でも根っこは似ている。"
    },
    "gh:grandfather": {
      "gh:type": "祖父 / 精神的支柱",
      "gh:dynamic": "多くを語らないが、千世の行動を黙って見守っている。"
    }
  },

  "gh:arc02Role": {
    "gh:position": "主人公",
    "gh:incident": "後輩の配信者・黒田涼がドクシング被害に遭い、相談を受ける。",
    "gh:growth": "感情的な報復ではなく、証拠と法的手続きで戦う方法を選ぶ。",
    "gh:theme": "『恥じゃない。残すのが一番強い』"
  },

  "gh:iconicScenes": [
    {
      "gh:scene": "正月の巫女姿",
      "gh:description": "「千世ちゃん、今年もよろしくね〜」「……うっす」",
      "gh:impact": "普段のストリート姿とのギャップ"
    },
    {
      "gh:scene": "境内での情報収集",
      "gh:description": "夜の神社で地元の情報屋と密談。「神様は見てるぞ」「見てねーよ」",
      "gh:impact": "神社と裏社会の接点"
    },
    {
      "gh:scene": "おばあちゃんの墓参り",
      "gh:description": "ストリートの格好で手を合わせる。「ばあちゃん、また厄介ごと拾っちまった」",
      "gh:impact": "家族への想い"
    }
  ]
}
