  },

  "gh:background": {
    "gh:family": {
      "gh:structure": "母と二人暮らし。父・沼野 信哉（しんや）は9年前（Ren 小3 冬）に他界。",
      "gh:father": "沼野 信哉（しんや）。元大学准教授。専門は (1) *情報物理学*（ランダウアーの原理『情報は物理量である』の理論研究、情報熱力学、Ghost = 情報生命体の数理モデル化）と (2) *量子コンピューター・サイエンス*（量子コンピューター OS の設計、量子・古典ハイブリッド暗号解析、Post-Quantum Cryptography 理論）。情報物理学と量子計算理論を *架橋した* 数少ない研究者として国際的に知られていた。SIP デバイス開発では *中核アルゴリズム* を担当 — Ghost 検出と情報場可視化を *量子・古典ハイブリッド計算* で実装する手法を設計。白瀬聡の *工学・ハードウェア実装* と二人三脚で開発。死去時、SIP デバイスは *国民年金情報の次世代防御基盤* として日本年金機構と共同パイロット導入される直前段階だった。家庭では穏やかで、幼い Ren に仏教と情報理論と量子のパズルを語り聞かせた。Ren が小学低学年の頃から書斎の PC を触らせ、暗号パズル・量子論的思考実験・プログラミングの基礎を教えていた。情報物理学会で、Nei の父・白瀬聡（工学系・SIP デバイス実装研究者）、Ayumu の父・七尾伊織（情報物理・実験物理、MIT）と 20 年来の親友。3 家族は子供の代まで家族ぐるみの付き合い。死後、信哉が独自にロックをかけた SIP デバイス試作機 1 台が遺品として残されている。ロックには信哉自身が考案した *『Trust Network Proof + Time-based One-Time Password』のハイブリッド方式* が使われており、白瀬博士でも開けられない。",
      "gh:mother": "翻訳家。父の死後、仕事に没頭して家を空けがち。悲しみを共有することを避けており、Ren との会話は最小限。放任というより『触れられない』関係。Ren が 17 歳の現在まで、この距離感が続いている。",
      "gh:atmosphere": "表向きは放任家庭。実態は母子ともに父の不在から目を逸らし続けている。9 年間、誰も父の書斎を整理していない。"
    },
    "gh:schoolReadkiriEra": "（読切時＝中3・15歳）市立C中学校 3年B組。成績は中の上だが、授業中はほぼ寝ている。夜型生活ゆえの睡眠負債が原因。『昼は教室で寝ている』スタイルはこの中学時代限定（連載では踏襲しない）。",
    "gh:schoolSerializedEra": "（連載時＝17歳）中3末に高卒認定試験（高等学校卒業程度認定試験）を独学で取得済み。高校に通う義務はないが、Nei が通う通信制『C高等学校』に同じく在籍（本人は『Nei が行くから』とだけ説明）。スクーリングは最低限の出席。昼は相変わらず怠惰だが、教室で寝ているわけではなく、自宅ソファ・カフェ・図書館で寝ている。",
    "gh:hackerOrigin": "父が小学低学年の頃から書斎のPCで暗号パズル・プログラミングの基礎を教えていた。父の死（小4夏）後、遺された研究ログ・SIP デバイス試作機・ランサムウェア攻撃の調査資料を追うために、独学でハッキング技術を積み上げ始める。小学校高学年から中学にかけて black0awd 系統の末端の痕跡を 1 つずつ辿り続け、中1時点で他人（Nei 母）を救える技術水準に達する。",
    "gh:currentState": "（連載時）News Hacker として Nei とコンビで活動。表向きは『生活費を稼ぐためのサイバーセキュリティのバイト』として企業・個人から有償で案件を受けている（母との関係が冷えており、Ren は自分の生活費を自分で稼いでいる）。バイトとしての仕事は最低限、本当の動機は父を社会的に殺した攻撃グループ『black0awd 系統』の系譜を辿ること、そして父の遺した SIP デバイス試作機を解錠すること。バイトの隙間で系統樹に繋がる事件だけを選別して追う。"
  },

  "gh:traumaIncident": {
    "gh:type": "大規模個人情報流出 + ランサムウェア複合攻撃 / 国家プロジェクト責任者としての公的責任 / 自死",
    "gh:name": "『沼野信哉 事件』（Ren家内での呼称） / 『国民年金 SIP 防御パイロット崩壊事件』（社会的呼称）",
    "gh:year": "Ren 8歳の冬（小3）— 攻撃発生 / Ren 9歳の夏（小4夏）— 父、自死",
    "gh:realIncidentMotif": "2015 年・日本年金機構 個人情報流出事件 をモチーフに、ランサムウェア要素 (近年の標的型攻撃の二重恐喝モデル) を加えて構成。実在事件の社会的責任構造 (理事長辞任・国会集中砲火・国民の信頼喪失) を借用",
    "gh:summary": "父・信哉は、白瀬聡（Nei父）と共同で開発中だった SIP デバイスの初期実装を、*国民年金情報の次世代防御基盤* として日本年金機構と共同で導入する国家パイロットプロジェクトの責任者だった。Ren が小3の冬、調整中だったシステムに対し、*高度に標的化されたメール攻撃 + ランサムウェアの複合攻撃* が発動。SIP プロトタイプは攻撃の進行を検知したが、*対応の自動化が間に合わず*、*約 400 万件の年金記録が流出*。さらに *バックアップ系も暗号化* されたため、*一部記録は完全喪失*。なりすまし被害 (年金不正請求・口座乗っ取り) が広範に発生し、*高齢被害者の自死報道* も複数。マスメディアと国会が *『SIP プロジェクトの失敗が国民の老後を殺した』* と糾弾し、父はプロジェクト責任者として *公的責任* を取らされて退職、公開謝罪。半年後、自宅で自死。父の遺体を最初に発見したのは Ren（当時 9 歳）。この記憶は 9 年経った連載時点でも鮮明に残り続けている。攻撃は当時『犯人不明の国際攻撃グループ』とされたが、本作読切で Ren が *同一作者署名のロゴ* を再発見し、*black0awd 系統* との同一性を確認する。",
    "gh:mechanism": [
      "事前 6 ヶ月の偵察 + 標的型メール (Emdivi 系の手口) で内部侵入",
      "年金機構の業務系ネットワークから本体系へ横展開",
      "二重恐喝モデル: *データ流出* (約 400 万件) + *ランサムウェアによる暗号化* (バックアップ含む)",
      "ロックスクリーンに *固有のロゴ署名* (後年、同一作者の他攻撃と照合可能になる)",
      "身代金要求は *形式的* — 真の目的は SIP プロジェクト潰しと推定される (父の理論が実用化されると、犯人側のビジネス全体が成立しなくなるため)",
      "二次被害として *なりすまし不正請求* が広範に発生、社会的責任が父に集中"
    ],
    "gh:perpetrator": "海外拠点の国際攻撃グループ。当時は犯人不明。本作読切で *black0awd 系統* と同一の作者署名（ロゴ・コードスタイル）が確認される。組織の中枢は東欧と推定。Ren が個人で追跡しているのは末端の日本オペレーション部隊。",
    "gh:fatherLastWords": "父が Ren に残した最後のメモ：『情報は物理だ。そして生きている。お前は、ゴーストを見ろ。』",
    "gh:fatherSIPDevice": {
      "gh:item": "父・信哉が個人的に持ち帰った SIP デバイス試作機 1 台（桐の小箱に入れて Ren の机の端に保管）",
      "gh:lock": "父が *中核アルゴリズム部分* を実装した上で、独自にロックをかけた状態。白瀬博士でも開けられない（白瀬は『工学・実装』担当、信哉は『量子・古典ハイブリッド計算 / 暗号コア』担当の役割分担だったため）",
      "gh:lockProtocol": "信哉が考案した *Vector Alignment Proof + TOTP ハイブリッド方式*。(1) パスワード自体は *5 秒ごとに新しい量子乱数に切り替わる* (TOTP) ため、盗聴・総当たりは事実上不可能。(2) 解錠条件は *総当たり計算* ではなく、*ハッシュ難易度* を下げること。(3) 難易度は *Vector Alignment Proof*（信哉が 9 年前に論文として書いた、人々が *同じベクトル* に向いたネットワークに加わることで *指数関数的に計算能力が向上する* 理論）に基づき、*ベクトルの揃ったネットワーク* が 1 つ拡大されるたびに *指数関数的に低下* する",
      "gh:theoreticalFoundation": "信哉の論文 (9 年前) は 3 つの既存理論を統合: (1) *情報熱力学* (Landauer) — 揃ったベクトルのネットワークはエントロピーが低く、利用可能情報量が増える。(2) *量子コンピューティング・ネットワーク理論* (entanglement-based distributed computing) — N 個の量子ビットがアラインしたとき、状態空間は 2^N にスケール。N 人が同じベクトルに揃うと、共有計算能力が 2^N に増大する。(3) *ジャンプ三原則の方程式化* (信哉が密かにアニメ・漫画好きで、論文の付録に *『努力 + 友情 = 勝利の指数関数解』* を真面目に書いていた) — 個々の努力 (effort) が、相互認識 (friendship) を通じて、計算的勝利 (victory) として表出する数式モデル",
      "gh:unlockMechanism": "*Ghost Hack の解決を通じて、人々が *同じベクトル* に向いた状態 (例: 被害者と加害者が共に『悪いのはアクター』と認識する / 仲間が同じ目的で動く / 観察者が証言する / 共通の敵を見出す等) が成立すると、SIP デバイスがそれを *Vector Alignment Proof* として記録。難易度が下がる。下がった分だけ *中核アルゴリズムの一部モジュール* が *部分復号* されて読めるようになる。完全解錠時には *父の遺した最終メッセージ + SIP コアの完全実装* がアンロックされる*",
      "gh:proofExamples": [
        "被害者と加害者が共通の敵 (アクター) を認識した瞬間 — 本話の Yuto / Saki / Mei / Akira 4 人連鎖",
        "仲間が新たに加わって同じベクトルに揃った瞬間 — Chise / Kaname / Ayumu 合流時に各 1 つ",
        "第三者の証言 / 観察 によってベクトルが整列した瞬間 — 警察・JPCERT・国際機関との協働",
        "敵対関係だった者同士が、共通の敵を前に協働を選んだ瞬間 — Part 2 以降の元加害者の改心系"
      ],
      "gh:visualization": "起動画面に常に表示される: (1) *Lock Difficulty: 2^N*（数値ゲージ・指数表示）、(2) *Vector Alignment Proof: M / ?*（増加カウンター、上限不明）、(3) *Decoded Modules: [list of unlocked algorithm fragments]*、(4) *ベクトル場のリアルタイム可視化*（情報場のベクトル整列度合いを矢印密度で表示）",
      "gh:totalProofs": "*不明*。本話で初めて *1 つ目* の Vector Alignment Proof が確立され、難易度が *2^256 → 2^240* に低下、Module 1（Ghost 検出の入力前処理ステップ）が部分復号される。残り回数の推定不能（連載の長期フック）",
      "gh:storyUse": "数話〜1 アークごとに 1 つの Proof が確立される設計。難易度は *指数関数的* に下がるため、最終巻まで *完全解錠は持ち越し*。完全解錠時に何が起きるかは Ren も知らない（父の真意の最終リビールに繋がる）",
      "gh:groundedReference": "実在する研究領域: 情報熱力学 (Landauer / Bennett) / 量子もつれ分散計算 / Bose-Einstein 凝縮 / Metcalfe 法則 / Web of Trust / Post-Quantum Cryptography / Verifiable Delay Functions / Coherence-driven computation。manga 的に *友情パワーアップ* に見えないよう、Nei が論文ベースの説明を 1 回入れる。同時に、信哉の *ジャンプ三原則の方程式化* という遊び心 (『努力 + 友情 = 勝利の指数関数解』) を、メタ的に作品全体のテーマと共鳴させる"
    },
    "gh:meaning": "Renの怒り・夜の追跡・Ghost Hackerとしての活動の全ての源泉。表向きは誰にも語らない。父の死は『個人の被害』ではなく『社会的責任の押し付け』だったため、Renの動機は *復讐* と *父の名誉回復* の両方を含む。",
    "gh:knownBy": ["character:Nei（幼馴染、事件を間近で共有）", "character:NeiFather（父の共同研究者・最も近い証人）"],
    "gh:secondaryTrauma": {
      "gh:type": "ネット・メディアによる遺族バッシング / 公的誹謗中傷",
      "gh:summary": "父の事件の社会的責任が父個人に集中した結果、*遺族* (8〜9 歳の Ren と母) も *マスメディアと匿名アカウント群* に晒された。週刊誌が小学校前で Ren を待ち伏せ、同級生に *タブロイド記事の切り抜き* が配られ、ネット掲示板では『この一族が国民の老後を奪った』『遺伝的に欠陥がある』など根拠のない誹謗が数千件レベルで投稿された。母は仕事を辞め、Ren は転校。9 年経った今も、父の名前で検索すると当時の記事と中傷が出る。",
      "gh:meaningForRen": "Ren の中で、*アクター（攻撃者）* と *罵る側（無自覚な加担者）* と *被害者* の 3 層構造が、生々しい体験として刻まれている。『*悪いのはアクター。被害者でも、罵る側でもない*』という強い信条の根拠。本話で Yuto を罵るクラスメイトに対し、Ren が珍しく強い口調で『*怒りの向け先を間違えるな*』と言うのは、この経験が直接の根拠"
    }
  },

  "gh:dualLife": {
    "gh:day": "気怠げな高校生。授業中は寝ている。友人は少ない。『だるい』『めんどくさい』が口癖。",
    "gh:night": "サイバー犯罪者追跡者（ハンター）。日付が変わる頃から起動。Neiと共にログを解析し、詐欺グループの踏み台サーバーを潰し、被害者の被害拡大を止めて回る。時に48時間ぶっ通しで追跡する。",
    "gh:switchTrigger": "事件の匂い（父と同じ手口・被害者の様子・情報場の違和感）を察知すると、昼のモードから深夜の追跡モードに一瞬で切り替わる。",
    "gh:contradiction": "昼の怠惰は演技ではなく、夜の過集中の反動として本当に疲弊している。二面性ではなく『同一人物の燃費の悪さ』。"
  },

  "gh:neurodiversity": {
    "gh:diagnosis": "ADHD（注意欠如・多動症、主に不注意優勢型 + 過集中傾向）",
    "gh:traits": {
      "gh:hyperfocus": "興味対象に対する過集中。夜の追跡では数十時間単位で没入し、食事・睡眠・連絡を忘れる。",
      "gh:inattentive": "興味のない授業・事務作業には全く集中できない。プリント紛失・忘れ物常習。",
      "gh:impulsive": "直感で即座に行動する衝動性。推理の跳躍・奇策の源でもある。",
      "gh:taskSwitching": "タスクの切り替えが極端に苦手。昼と夜のモード差が大きい一因。",
      "gh:timeBlindness": "時間感覚が弱い。『気づいたら朝』『約束を忘れる』",
      "gh:stimulusSeeking": "退屈への耐性が極端に低い。『退屈しのぎ』発言の本質はADHD的刺激追求。"
    },
    "gh:strengthFraming": "過集中＝夜のハンター能力の正体。直感＝Ghost解析の跳躍力。退屈耐性の低さ＝事件を嗅ぎつけるセンサー。障害ではなく『武器として活かしている特性』。",
    "gh:weaknessFraming": "授業・日常生活・対人連絡の取りこぼし。Neiが昼の生活を支えている関係性の根拠。",
    "gh:selfAwareness": "Ren自身はまだ『診断』を受けていない。父の死後、自分の生活リズムが崩壊しているのを『性格』と誤認している段階。連載中盤で自覚イベントを設計可能。"
  },

  "gh:sensitivityNote": {
    "gh:policy": "ADHDは『障害』ではなく『特性・強み』として描写する。ステレオタイプ（『集中力がない＝ダメな人』）を避け、過集中・直感・パターン認識の強みと、生活のしづらさの両面を描く。",
    "gh:editorialGuideline": "商業化時は当事者コミュニティ（ADHD当事者会）および精神科医（児童青年精神医学会所属医師など）の監修を前提とする。",
    "gh:representation": "『治す対象』『甘え』として扱わない。診断名を物語的利用のみでラベリング消費しない。"
  },

  "gh:comedyRole": {
    "gh:type": "怠惰ギャグ / ボケ（メイン）",
    "gh:gagsReadkiriEra": [
      "読切（中学生時代）限定: 教室で授業中に寝ている。先生に当てられて『……だるい』と返答",
      "読切限定: 寝起きのガバッと覚醒リアクション（髪ぼさぼさ・イヤホン片方外れ）"
    ],
    "gh:gagsSerializedEra": [
      "どこでも寝る（自宅ソファ・カフェ・図書館・父の部屋・駐輪場のタイヤの上・スクーリング会場の待合室）※ただし教室ではない",
      "寝起きのガバッと覚醒リアクション（髪ぼさぼさ・Nei に無理やりパンを口に突っ込まれる）",
      "急に瞳が銀色に光る瞬間のシリアス切替（コマ 1 つだけ）",
      "『だるい』『めんどくせー』『根っこを切る』『一回で、片付ける』の口癖系",
      "過集中時の記憶飛び（『今、何曜日』『昨日、何食った』『Nei が来たのが昨日か今日か』系）",
      "バイト代の使い方がいびつ（高級キーボード・高スペックサーバー・父のキーボードの修理費・Nei へのパンの差し入れ）",
      "サイバーセキュリティのバイト依頼を『めんどくせー』で 7 割断るが、残り 3 割だけ系統樹判定で受注"
    ],
    "gh:balance": "ギャグ 7 : シリアス 3。シリアス切替の瞬間は必ず瞳の銀色 1 コマで予告。",
    "gh:donotcross": "父の死の回想・父の銀色のキーボードに触れるシーン・決定的 1 選択の瞬間・母との関係の描写はコメディ封印。",
    "gh:note": "食いしん坊属性は Nei に移譲された。Ren は食べ物への執着が弱く、Nei が差し入れたパンやおにぎりを事務的に口に入れるだけ（味わわず燃料として摂取）。"
  },

  "gh:hiddenBackground": {
    "gh:religion": "仏教（天台宗）",
    "gh:connection": "沼野家は比叡山延暦寺に連なる末寺の檀家総代を代々務めてきた。祖父は熱心な信者で、幼いRenを寺に連れて行った。",
    "gh:nameOrigin": "『蓮（Ren）』は蓮華＝仏教の象徴。祖父が「泥の中から美しく咲く蓮のように」と願いを込めて名付けた。",
    "gh:influence": "Ren自身は無宗教を自認しているが、天台宗の『一念三千』（一瞬の心に三千の世界が宿る）という世界観が、情報の海から本質を見抜く直感に繋がっている。",
    "gh:symbol": "蓮は泥（混沌・情報の海）の中から咲く。天台の止観（瞑想と観察）＝Renの鋭い観察眼のルーツ。",
    "gh:tendaiConcepts": {
      "gh:ichinenSanzen": "一念三千 - 一瞬に全てを見通す直感力の源",
      "gh:shikan": "止観 - 止（集中）と観（洞察）。Renの『だるい』の裏にある静かな観察眼",
      "gh:enryakuji": "比叡山延暦寺 - 日本仏教の母山。多くの宗派がここから生まれた"
    },
    "gh:storyUse": "表立っては出てこないが、Renの『だるい』『めんどくさい』の裏にある諦観と、一瞬で本質を見抜く直感は天台の止観に通じる。"
  },

  "gh:personality": {
    "gh:surface": "気怠げ。「だるい」「めんどくさい」が口癖。やる気がなさそう。",
    "gh:hidden": "実は観察眼が鋭く、本質を見抜く。困っている人を放っておけない。",
    "gh:motivation": {
      "gh:surface": "『退屈しのぎ』",
      "gh:real": "父・信哉を死に追いやった詐欺ネットワーク『Kurosagi-Net』への強い怒り。父と同じ被害を繰り返させないという決意。表向きは誰にも語らない。",
      "gh:code": "『金じゃなく人を見ろ』——父の遺したメモをコード化した自分だけのルール。案件を受けるか決めるのは依頼の金額ではなく、被害者の人生が潰れかけているかどうか。"
    },
    "gh:weakness": "人付き合いが苦手。感情を表に出さない。父の話題は現時点で封印している。Neiの前でだけ、ごく稀に本音が漏れる。"
  },

  "gh:skills": {
    "gh:hackerName": "Ghost Hacker / Ren",
    "gh:specialAbility": "SIP Project Map - 情報場を可視化し、Ghostを認識する能力",
    "gh:weapon": "NULL AXE - Ghostを断つデジタル武器",
    "gh:technical": [
      "直感的なパターン認識",
      "ネットワーク解析",
      "ソーシャルエンジニアリング",
      "即興的な問題解決"
    ]
  },

  "gh:onlinePresence": {
    "gh:avatar": {
      "gh:type": "verylonganimals",
      "gh:animal": "フクロウ (Owl)",
      "gh:description": "verylonganimalsのながーいフクロウ。夜行性で物静か、でも鋭い目で全てを見通す。Renの『だるい』けど本質を見抜く性格にピッタリ。",
      "gh:color": "ダークグレー / 銀色の目",
      "gh:usage": "SNS、チャット、匿名掲示板での活動時に使用",
      "gh:reason": "フクロウ＝夜の賢者。止観（観察と洞察）の象徴。一見眠そうだが、実は何も見逃さない。"
    },
    "gh:handleVariations": ["Ren", "Ghost_Owl", "ながふくろう"]
  },

  "gh:relationships": {
    "gh:nei": {
      "gh:type": "幼馴染 / バディ / 事実上のパートナー / 同級生（C高校 2年・別クラス）",
      "gh:history": "5歳から隣家の幼馴染。Ren父とNei父（物理学者）が学会仲間で、家族ぐるみの付き合い。Ren父の詐欺被害を幼いながらに見ていた数少ない人物。父の死後、崩壊しそうだったRenを支え続けている。",
      "gh:dynamic": "阿吽の呼吸。言葉少なくても通じ合う。朝はNeiが隣の家からRenを引きずり出して一緒に登校する。Renの過集中にはNeiがブレーキをかける。互いに呼び捨てで、Neiは常にカタカナで『レン』と呼ぶ（幼少期に漢字が書けず『レン』と書いていたのが定着）。RenはNeiを『Nei』と呼ぶ。Neiは他人には丁寧語だが、Renにだけは常にタメ口・呼び捨て。",
      "gh:codependence": "Renは夜の追跡のトリガー。Neiは昼の生活のトリガー。どちらが欠けても2人とも機能しなくなる。"
    },
    "gh:chise": {
      "gh:type": "ライバル / 同志",
      "gh:dynamic": "手法は違うが目指す場所は同じ。Chiseの直情的な部分にたまにイラっとする。"
    },
    "gh:kaname": {
      "gh:type": "ライバル / 対照的な存在",
      "gh:dynamic": "Kanameの『論理』にRenの『直感』。水と油だが、互いの実力は認めている。"
    }
  }
}
