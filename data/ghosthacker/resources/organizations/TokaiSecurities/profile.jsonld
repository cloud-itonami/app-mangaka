  "gh:incidentReport": {
    "@id": "incident:260125-jump-AccountFraud",
    "dct:date": "2026-11-28",
    "dct:title": "顧客口座不正出金事件",
    "gh:ghost": {
      "gh:form": "ガイドライン文書で築かれた砂の城。見た目は堅牢だが、一点を突くと崩れる。",
      "gh:name": "規程の城",
      "gh:origin": "形式主義への過信が物理化"
    },
    "gh:impact": "顧客資産流出。金融庁への報告義務。レピュテーションリスク。",
    "gh:rootCause": "『金融庁ガイドライン遵守』という傲慢。最低ラインを満たしただけで安心し、重要操作MFA・異常検知・冷却期間・24/7監視・委託先統制が不十分だった。",
    "gh:symptoms": [
      "複数顧客の受取口座が無断変更",
      "変更直後の大口出金",
      "ログインMFAは突破されていない（セッションハイジャック）",
      "重要操作へのMFA未適用が露呈",
      "ログは存在したが相関分析されておらず検知遅延"
    ]
  },
