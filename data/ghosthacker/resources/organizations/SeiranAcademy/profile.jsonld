  "gh:securityPostureForStory": {
    "gh:baseline": "『うちの生徒に限って』という根拠のない信頼",
    "gh:teachingGoal": "どんな立場の人間も被害者になりうる。早期の相談と正規の手続きが最善。",
    "gh:weakPoints": [
      "プライドが高く、被害を認められない",
      "親に知られたくない一心で解決を遅らせる",
      "『お金で解決できる』という思い込み"
    ]
  },
  "gh:slug": "SeiranAcademy",
  "gh:storyIncident": {
    "gh:blackMarketConnection": "斡旋者は星蘭の卒業生で、インサイダー情報を売買するネットワークの末端",
    "gh:escalation": [
      "「簡単なアンケート回答」として始まる",
      "報酬が増えるにつれ、要求される情報が機密性を帯びてくる",
      "親のPCから資料を撮影するよう指示される",
      "断ろうとすると、これまでの『協力』の証拠で脅迫される",
      "『やめたいけど、怖くてやめられない』状態に"
    ],
    "gh:solution": "Kanameが相談を受け、警察・弁護士・学校の連携による解決を組み立てる。早期の相談が被害を最小限に抑える。",
    "gh:summary": "成績優秀だが経済的に余裕のない特待生・青山ソラが、『簡単な情報収集の仕事』に手を出す。最初は企業のアンケート代行だったが、次第に親の仕事関連の内部情報を要求されるように。",
    "gh:type": "闇バイト（上流向け・情報売買）"
  },
  "gh:studentCulture": [
    "SNSでは『映える』生活をアピール（ブランド品、高級レストラン、海外旅行）",
    "親の期待とプレッシャーが重い",
    "『成功して当然』という空気の中での閉塞感",
    "お金はあるが、自分で稼いだものではないというコンプレックス"
  ],
  "gh:typicalRisks": [
    "『簡単に稼げる』投資詐欺・暗号資産詐欺への勧誘",
    "闇バイトの『上流向け』バージョン（情報横流し、名義貸し）",
    "SNSでの見栄の張り合いから生まれる金銭トラブル",
    "家族の名前を使った詐欺への巻き込まれ"
  ],
  "gh:visualStyle": {
    "gh:buildingExterior": "赤レンガと白い柱のヨーロッパ風校舎。広い芝生の中庭。",
