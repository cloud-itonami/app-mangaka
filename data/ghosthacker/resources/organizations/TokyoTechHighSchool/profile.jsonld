  "gh:visualStyle": {
    "gh:buildingExterior": "5階建ての古めの校舎。工場の煙突が見える。屋上に古いアンテナ。",
    "gh:interior": "実習室にはCNCマシンや3Dプリンター。PC室は自作PCが並ぶ。",
    "gh:season": "秋（涼しくなり始めた頃）",
    "gh:uniform": "ネイビーのブレザーだが、着崩している生徒が多い。"
