  "gh:securityPostureForStory": {
    "gh:baseline": "技術系の生徒が多いため『自分で対処できる』という過信がある",
    "gh:teachingGoal": "『残す』『相談する』『手続きを踏む』が最強の対抗策であることを示す",
    "gh:weakPoints": [
      "証拠の保存方法を知らない",
      "警察・法的手段への心理的ハードルが高い",
      "『恥ずかしい』が先に立って相談できない"
    ]
  },
  "gh:slug": "TokyoTechHighSchool",
  "gh:storyIncident": {
    "gh:escalation": [
      "配信中の背景から住所を特定される",
      "SNSに本名・学校名が晒される",
      "『犯罪予告』を装った脅迫メッセージ",
      "学校・自宅への嫌がらせ（ピザの大量注文等）"
    ],
    "gh:solution": "Chiseが証拠保存の手順を教え、開示請求と警察相談の流れを組み立てる。最終的に加害者の特定につながる。",
    "gh:summary": "人気ゲーム配信者の2年生・黒田涼（Ryo）が、匿名掲示板で住所・本名を晒され、誹謗中傷が拡散。学校にも嫌がらせ電話が来るようになる。",
    "gh:type": "オンライン誹謗中傷・ドクシング"
  },
  "gh:studentCulture": [
    "ゲーム配信やeスポーツに熱心な層が一定数いる",
    "オンラインでの人間関係が現実と同等かそれ以上に重要",
    "匿名掲示板やSNSでの『特定』『晒し』が日常的な脅威",
    "技術力があるがゆえにサイバーいじめが巧妙化"
